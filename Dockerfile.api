FROM python:3.11-slim

WORKDIR /app

# Install dependencies first (separate layer) so Docker can cache this
# step and skip reinstalling every time only application code changes.
COPY api/requirements.txt ./api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

# Copy the API code and the one file it needs from src/training/
# (get_tracking_uri), preserving the same relative folder structure
# main.py already expects locally.
COPY api/ ./api/
COPY src/training/common.py ./src/training/common.py

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]