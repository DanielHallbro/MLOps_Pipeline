# AWS credentials if you want to use S3 as a remote storage for DVC.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=eu-north-1

# MLflow database configuration
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme # This is the only field to be changed. No account made on a third party service, so no security risk. This is only for local development.
POSTGRES_DB=mlflow

# Airflow's own Postgres (separate from MLflow's database)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=changeme # This is the only field to be changed. No account made on a third party service, so no security risk. This is only for local development.
AIRFLOW_POSTGRES_DB=airflow

# Airflow needs a Fernet key for encrypting sensitive data.
AIRFLOW_UID=1000
AIRFLOW_FERNET_KEY=changeme_generate_a_real_one
# You can generate a Fernet key by running the following command in Python:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# if that doesn't work, you can run it through the training container with the following command:
# docker compose run --rm training python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())

# Airflow's webserver needs a secret key for displaying logs in the web UI. You can generate a secret key by running the following command in Python:
# docker compose run --rm training python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=changeme_generate_a_real_one

# Airflow's webserver needs an admin user to log in. You can change these values if you want, but they are only for local development.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# Slack webhook URL for sending Airflow DAG alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER

# Grafana credentials for local development & visualization. You can change these values if you want, but they are only for local development.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme # This is the only field to be changed. No account made on a third party service, so no security risk. This is only for local development.