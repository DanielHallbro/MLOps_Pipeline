FROM python:3.11-slim

WORKDIR /app

COPY src/training/requirements.txt ./src/training/requirements.txt
RUN pip install --no-cache-dir -r src/training/requirements.txt

# DVC only needed here (for dvc pull), not in Airflow's image, so it's
# a separate install rather than bundled into the shared requirements
# file both Dockerfile.training and Dockerfile.airflow reference.
RUN pip install --no-cache-dir "dvc[s3]==3.67.1"

# This container isn't meant to stay running (see docker-compose.yml's
# comment on the training service) - docker compose up starts it with
# no command override. CMD here just gives an explicit, guaranteed
# clean exit rather than relying on the base image's default (bare
# python3, which happens to exit clean on closed stdin but isn't
# something to depend on). docker compose run --rm training
# <real command> overrides this as normal.
CMD ["true"]